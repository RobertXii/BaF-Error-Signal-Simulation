Cell[CellGroupData[{

Cell[BoxData[{
 StyleBox[
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"overlap", "[", 
      RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"mat", ",", "vals", ",", "vecs", ",", "ov"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"z", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "2"}], "I"}], "+", "\[Delta]"}]}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"mat", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "1"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", 
             RowBox[{"(", 
              RowBox[{"x", "+", 
               RowBox[{"I", " ", "y"}]}], ")"}]}], "}"}]}], "}"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Compute", " ", "right", " ", "eigenvalues", " ", "and", " ", 
          "eigenvectors"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"vals", ",", "vecs"}], "}"}], "=", 
         RowBox[{"Eigensystem", "[", "mat", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Compute", " ", "the", " ", "overlap", " ", "between", " ", "the", " ",
           "two", " ", "eigenvectors"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"ov", "=", 
         RowBox[{
          RowBox[{"ConjugateTranspose", "[", 
           RowBox[{"vecs", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}], ".", 
          RowBox[{"vecs", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
        "ov"}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Plot", " ", "the", " ", "absolute", " ", "value", " ", "of", " ", "the", 
     " ", "overlap", " ", "in", " ", "3", "D"}], "*)"}]}],
  FontSize->18], "\n", 
 StyleBox[
  RowBox[{"Plot3D", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Abs", "[", 
     RowBox[{"overlap", "[", 
      RowBox[{"x", ",", "y"}], "]"}], "]"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"x", ",", 
      RowBox[{"-", "5"}], ",", "5"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"y", ",", 
      RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"AxesLabel", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<Re(z)\>\"", ",", "\"\<Im(z)\>\"", 
       ",", "\"\<|Overlap|\>\""}], "}"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{"PlotRange", "->", "All"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Mesh", "->", "None"}], ",", "\[IndentingNewLine]", 
    RowBox[{"ColorFunction", "->", "\"\<Rainbow\>\""}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"PlotLabel", "->", "\"\<Absolute Overlap vs. z\>\""}]}], 
   "\[IndentingNewLine]", "]"}],
  FontSize->18]}], "Input",
 CellChangeTimes->{{3.9494411531370907`*^9, 3.949441197025566*^9}, {
   3.949441227927546*^9, 3.949441276151759*^9}, 3.9494417397390423`*^9},

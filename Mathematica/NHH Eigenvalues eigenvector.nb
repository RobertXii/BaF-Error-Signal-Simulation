Cell[CellGroupData[{

Cell["Exceptional Point", "Section",
 CellChangeTimes->{{3.9494472265949907`*^9, 
  3.949447228945156*^9}},ExpressionUUID->"83a8269d-c4f0-4ed9-862a-\
e4158fbc16e1"],

Cell[CellGroupData[{

Cell["\<\
The exceptional point is found when the eigenenergies degenerate, which \
occurs when the stuff under the square root vanishes\
\>", "Subsection",
 CellChangeTimes->{
  3.949447221393536*^9},ExpressionUUID->"4019038c-3f22-4d0e-85d9-\
4b7c2668614b"],

Cell[CellGroupData[{

Cell[BoxData[{
 StyleBox[
  RowBox[{"Clear", "[", 
   RowBox[{"x", ",", "y", ",", "a"}], "]"}],
  FontSize->18], "\n", 
 StyleBox[
  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"4", " ", 
        RowBox[{"x", "^", "2"}]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"y", "-", 
          RowBox[{"I", " ", 
           RowBox[{"a", "/", "2"}]}]}], ")"}], "^", "2"}]}], "==", "0"}], "&&", 
     RowBox[{"Element", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", "y", ",", "a"}], "}"}], ",", "Reals"}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "y"}], "}"}]}], "]"}],
  FontSize->18]}], "Input",
 CellChangeTimes->{{3.949447316989038*^9, 3.949447317525505*^9}},
 CellLabel->
  "In[1068]:=",ExpressionUUID->"144a39b7-16ae-42e7-9731-9618c2962caf"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", "\[Rule]", 
      TemplateBox[{
        RowBox[{"-", 
          FractionBox[
           SqrtBox[
            SuperscriptBox["a", "2"]], "4"]}], 
        RowBox[{"a", "\[Element]", 
          TemplateBox[{}, "Reals"]}]},
       "ConditionalExpression"]}], ",", 
     RowBox[{"y", "\[Rule]", 
      TemplateBox[{"0", 
        RowBox[{"a", "\[Element]", 
          TemplateBox[{}, "Reals"]}]},
       "ConditionalExpression"]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", "\[Rule]", 
      TemplateBox[{
        FractionBox[
         SqrtBox[
          SuperscriptBox["a", "2"]], "4"], 
        RowBox[{"a", "\[Element]", 
          TemplateBox[{}, "Reals"]}]},
       "ConditionalExpression"]}], ",", 
     RowBox[{"y", "\[Rule]", 
      TemplateBox[{"0", 
        RowBox[{"a", "\[Element]", 
          TemplateBox[{}, "Reals"]}]},
       "ConditionalExpression"]}]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{{3.949447288749958*^9, 3.949447318205845*^9}},
 CellLabel->
  "Out[1069]=",ExpressionUUID->"45cd0d63-2ac4-4e8e-b1d7-b3a77a41e3ca"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
2-Level system Laser Depletion using non-Hermitian Berry phase approach \
(actually, there\[CloseCurlyQuote]s no geometric phase)\
\>", "Section",
 CellChangeTimes->{{3.949524517420945*^9, 3.949524553609631*^9}, {
  3.949524727209098*^9, 
  3.949524744712699*^9}},ExpressionUUID->"79693a62-8539-477f-8409-\
d32b9afc2a76"],

Cell[CellGroupData[{

Cell["\<\
Assumptions: 1. Adiabatic; 2. initial state is (1,0). This uses the berry \
phase formula brought up in one of the paper. The model is a two level system \
with a depletion laser L2, initially populated at the stable level, this \
formula only correctly gives the population after exactly one cycle is \
complete. However, since we only move along a line in parameter space, we \
didn\[CloseCurlyQuote]t actually enclose any area inside this parameter \
space, so the Barry phase should be 0. This is just to give an example usage \
of this formula and to see if this correctly describe the depletion behavior.\
\
\>", "Subsection",
 CellChangeTimes->{{3.9495245788995934`*^9, 3.949524604294849*^9}, {
  3.949524646598488*^9, 3.949524665556481*^9}, {3.949524747338278*^9, 
  3.949524785663083*^9}, {3.949524844719369*^9, 3.9495250654767323`*^9}, {
  3.949525797716978*^9, 
  3.9495258133592863`*^9}},ExpressionUUID->"5c7fdc43-3342-4871-ac39-\
de0d068b63f1"],

Cell[CellGroupData[{

Cell[BoxData[{
 StyleBox[
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", "Parameters", "*)"}]}],
  FontSize->18], "\[IndentingNewLine]", 
 StyleBox[
  RowBox[{
   RowBox[{"Delta2", "=", 
    RowBox[{"3", " ", 
     RowBox[{"10", "^", "6"}], " ", "2", " ", "Pi"}]}], ";"}],
  FontSize->18], "\n", 
 StyleBox[
  RowBox[{
   RowBox[{"gamma", "=", 
    RowBox[{"2.7", " ", 
     RowBox[{"10", "^", "6"}], " ", "2", "Pi"}]}], ";"}],
  FontSize->18], "\n", 
 StyleBox[
  RowBox[{
   RowBox[{"c", "=", "1000"}], ";"}],
  FontSize->18], "\n", 
 StyleBox[
  RowBox[{
   RowBox[{"sigma", "=", 
    RowBox[{"0.52", " ", 
     RowBox[{"10", "^", 
      RowBox[{"(", 
       RowBox[{"-", "6"}], ")"}]}]}]}], ";"}],
  FontSize->18], "\n", 
 StyleBox[
  RowBox[{
   RowBox[{
    RowBox[{"t0", "=", 
     RowBox[{"52.6", " ", 
      RowBox[{"10", "^", 
       RowBox[{"(", 
        RowBox[{"-", "6"}], ")"}]}]}]}], ";"}], "  ", 
   RowBox[{"(*", 
    RowBox[{"Center", " ", "of", " ", "the", " ", "Gaussian"}], "*)"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Define", " ", "the", " ", "Gaussian", " ", "coupling", " ", "profile"}], 
    "*)"}]}],
  FontSize->18], "\[IndentingNewLine]", 
 StyleBox[
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Omega", "[", "t_", "]"}], ":=", " ", 
     RowBox[{"c", " ", "*", " ", 
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"t", "-", "t0"}], ")"}], "^", "2"}]}], "/", 
         RowBox[{"(", 
          RowBox[{"2", " ", 
           RowBox[{"sigma", "^", "2"}]}], ")"}]}], "]"}], "/", "2"}]}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Define", " ", "the", " ", "eigenvalue", " ", "\[Lambda]\:208a", 
     RowBox[{"(", "t", ")"}], " ", "expanded"}], "*)"}]}],
  FontSize->18], "\[IndentingNewLine]", 
 StyleBox[
  RowBox[{
   RowBox[{
    RowBox[{"lambdaPlus", "[", "t_", "]"}], ":=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"Delta2", "-", 
       RowBox[{"I", " ", 
        RowBox[{"gamma", "/", "2"}]}], "+", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"Delta2", "-", 
            RowBox[{"I", " ", 
             RowBox[{"gamma", "/", "2"}]}]}], ")"}], "^", "2"}], "+", 
         RowBox[{"4", " ", 
          RowBox[{
           RowBox[{"Omega", "[", "t", "]"}], "^", "2"}]}]}], "]"}]}], ")"}], "/",
      "2"}]}], ";"}],
  FontSize->18], "\[IndentingNewLine]", 
 StyleBox[
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"lambdaMinus", "[", "t_", "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"Delta2", "-", 
        RowBox[{"I", " ", 
         RowBox[{"gamma", "/", "2"}]}], "-", 
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"Delta2", "-", 
             RowBox[{"I", " ", 
              RowBox[{"gamma", "/", "2"}]}]}], ")"}], "^", "2"}], "+", 
          RowBox[{"4", " ", 
           RowBox[{
            RowBox[{"Omega", "[", "t", "]"}], "^", "2"}]}]}], "]"}]}], ")"}], 
      "/", "2"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Compute", " ", "the", " ", "dynamic", " ", "phase", " ", "\[CurlyPhi]", 
      " ", "as", " ", "the", " ", "integral", " ", "from"}], "-", 
     RowBox[{"\[Infinity]", " ", "to", " ", "\[Infinity]"}]}], "*)"}]}],
  FontSize->18], "\n", 
 StyleBox[
  RowBox[{
   RowBox[{"phi", "=", 
    RowBox[{
     RowBox[{"-", "I"}], " ", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{"lambdaPlus", "[", "t", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", 
         RowBox[{
          RowBox[{"-", "51.1"}], " ", 
          RowBox[{"10", "^", 
           RowBox[{"(", 
            RowBox[{"-", "6"}], ")"}]}]}], ",", 
         RowBox[{"200", " ", 
          RowBox[{"10", "^", 
           RowBox[{"(", 
            RowBox[{"-", "6"}], ")"}]}]}]}], "}"}], ",", 
       RowBox[{"Assumptions", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"sigma", ">", "0"}], ",", 
          RowBox[{"c", ">", "0"}]}], "}"}]}]}], "]"}]}]}], ";"}],
  FontSize->18], "\[IndentingNewLine]", 
 StyleBox[
  RowBox[{
   RowBox[{
    RowBox[{"phiMinus", "=", 
     RowBox[{
      RowBox[{"-", "I"}], " ", 
      RowBox[{"Integrate", "[", 
       RowBox[{
        RowBox[{"lambdaMinus", "[", "t", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", 
          RowBox[{
           RowBox[{"-", "51.1"}], " ", 
           RowBox[{"10", "^", 
            RowBox[{"(", 
             RowBox[{"-", "6"}], ")"}]}]}], ",", 
          RowBox[{"200", " ", 
           RowBox[{"10", "^", 
            RowBox[{"(", 
             RowBox[{"-", "6"}], ")"}]}]}]}], "}"}], ",", 
        RowBox[{"Assumptions", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"sigma", ">", "0"}], ",", 
           RowBox[{"c", ">", "0"}]}], "}"}]}]}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Compute", " ", "the", " ", "evolution", " ", "factor", " ", "f"}], "=", 
     
     RowBox[{"exp", 
      RowBox[{"(", "\[CurlyPhi]", ")"}]}]}], "*)"}]}],
  FontSize->18], "\[IndentingNewLine]", 
 StyleBox[
  RowBox[{
   RowBox[{"evolutionFactor", "=", 
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{"Exp", "[", "phi", "]"}], "]"}], "^", "2"}]}], ";"}],
  FontSize->18], "\[IndentingNewLine]", 
 StyleBox[
  RowBox[{
   RowBox[{"evolutionFactorminus", "=", 
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{"Exp", "[", "phiMinus", "]"}], "]"}], "^", "2"}]}], ";"}],
  FontSize->18], "\[IndentingNewLine]", 
 StyleBox[
  RowBox[{"{", 
   RowBox[{"phi", ",", "phiMinus"}], "}"}],
  FontSize->18], "\[IndentingNewLine]", 
 StyleBox[
  RowBox[{"{", 
   RowBox[{"evolutionFactor", ",", "evolutionFactorminus"}], "}"}],
  FontSize->18]}], "Input",
 CellChangeTimes->{{3.949525070067293*^9, 3.949525073705036*^9}, 
   3.9495253989126663`*^9, {3.949525544202808*^9, 3.949525699421418*^9}, 
   3.949525897111562*^9, {3.949526054720551*^9, 3.949526109677885*^9}, {

   StyleBox[
    RowBox[{"(*", 
     RowBox[{
     "Define", " ", "a", " ", "function", " ", "that", " ", "returns", " ", 
      "the", " ", "overlap", " ", "between", " ", "the", " ", "two", " ", 
      "right", " ", "eigenvectors", " ", "of", " ", 
      RowBox[{
       RowBox[{"M", "[", "x", "]"}], "."}]}], "*)"}],
    FontSize->18], "\[IndentingNewLine]", 
   StyleBox[
    RowBox[{
     RowBox[{
      RowBox[{"overlapOfEigenvectors", "[", "x_", "]"}], ":=", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"vals", ",", "vecs", ",", "ov"}], "}"}], ",", 
        RowBox[{"(*", 
         RowBox[{"Get", " ", "eigenvalues", " ", "and", " ", 
          RowBox[{"(", "right", ")"}], " ", "eigenvectors", " ", "of", " ", 
          RowBox[{
           RowBox[{"M", "[", "x", "]"}], "."}]}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"vals", ",", "vecs"}], "}"}], "=", 
          RowBox[{"Eigensystem", "[", 
           RowBox[{"M", "[", "x", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"In", " ", "Mathematica"}], ",", 
           RowBox[{
            RowBox[{"vecs", "[", 
             RowBox[{"[", "1", "]"}], "]"}], " ", "and", " ", 
            RowBox[{"vecs", "[", 
             RowBox[{"[", "2", "]"}], "]"}], " ", "are", " ", "column", " ", 
            RowBox[{"vectors", ".", "The"}], " ", "usual", " ", 
            RowBox[{"\[OpenCurlyDoubleQuote]", 
             RowBox[{"bra", "-", "ket"}], "\[CloseCurlyDoubleQuote]"}], " ", 
            "overlap", " ", "is", " ", 
            RowBox[{
             RowBox[{"v1", "^"}], "\\", "dagger"}], " ", "v2"}], ",", 
           RowBox[{"which", " ", "is", " ", 
            RowBox[{
             RowBox[{"ConjugateTranspose", "[", "v1", "]"}], ".", "v2"}], " ",
             "in", " ", 
            RowBox[{"Mathematica", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"ov", "=", 
          RowBox[{
           RowBox[{"ConjugateTranspose", "[", 
            RowBox[{"vecs", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "]"}], ".", 
           RowBox[{"vecs", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"Return", " ", "that", " ", 
           RowBox[{"overlap", "."}]}], "*)"}], "ov"}]}], "]"}]}], ";"}],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Clear", " ", "any", " ", "previous", " ", "definitions", " ", "for", " ", 
    "the", " ", "variables"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", 
     RowBox[{
     "Delta", ",", "K1", ",", "K4", ",", "E0nr", ",", "a", ",", "phi", ",", 
      "K3", ",", "\[CapitalGamma]", ",", "Delta2", ",", "T"}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Define", " ", "the", " ", "analytic", " ", "asymmetry", " ", "function", 
     " ", 
     RowBox[{"A", "[", "Delta", "]"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"A", "[", "Delta_", "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "2"}], "*", "K1", "*", "K4", "*", "E0nr", "*", 
        RowBox[{"Sin", "[", 
         RowBox[{"Delta", "*", "phi"}], "]"}], "*", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"Delta", "^", "2"}]}], "/", 
          RowBox[{"(", 
           RowBox[{"4", "*", "a"}], ")"}]}], "]"}], "*", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"K3", "*", 
            RowBox[{"\[CapitalGamma]", "/", "2"}]}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Delta2", "^", "2"}], "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"\[CapitalGamma]", "/", "2"}], ")"}], "^", "2"}]}], 
           ")"}]}], "]"}], "*", 
        RowBox[{"Sin", "[", 
         RowBox[{
          RowBox[{"Delta", "*", 
           RowBox[{"(", 
            RowBox[{"T", "-", "phi"}], ")"}]}], "-", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"K3", "*", "Delta2"}], ")"}], "/", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Delta2", "^", "2"}], "+", 

Cell[CellGroupData[{

Cell["Eigenvectors", "Section",
 CellChangeTimes->{{3.949440682084553*^9, 
  3.9494406869882927`*^9}},ExpressionUUID->"1009a2f9-b6a8-45f2-ac13-\
9c281855c935"],

Cell[CellGroupData[{

Cell["\<\
Similarly, eigenvector of the NHH is also kinda strange: \
It\[CloseCurlyQuote]s not necessarily orthogonal to each other (only \
biorthogonal). This effect can be seen around the exceptional point, where at \
the exceptional point (EP), the two eigenvectors are actually colinear, which \
corresponds to where the eigenvalues coincide. This can be shown by plotting \
the overlap between the two eigenvectors (both left or both right) around the \
EP. In this part, I calculated the normalized left/right eigenvectors, then I \
plot the overlap behavior of the eigenvectors around the EP of a demo NHH. \
\>", "Subsection",
 CellChangeTimes->{{3.94944130007763*^9, 3.9494416042799892`*^9}, {
  3.949441764467072*^9, 
  3.949441786557098*^9}},ExpressionUUID->"f62edf48-21a8-41ce-89a5-\
f2721fc771e4"],

Cell[BoxData[""], "Input",
 CellChangeTimes->{{3.9494404178037*^9, 3.949440432996399*^9}},
 FontSize->18,ExpressionUUID->"118cbeb4-60be-4929-bc60-68f3bf963778"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"M", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "x"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "z"}], "}"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Compute", " ", "the", " ", "right", " ", "and", " ", "left", " ", 
    RowBox[{"eigenvalues", "/", "eigenvectors"}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"valsR", ",", "vecsR"}], "}"}], "=", 
   RowBox[{"Eigensystem", "[", "M", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"valsL", ",", "vecsL"}], "}"}], "=", 
    RowBox[{"Eigensystem", "[", 
     RowBox[{"ConjugateTranspose", "[", "M", "]"}], "]"}]}], ";"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Print", " ", "normalized", " ", "eigenvectors"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Do", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"vR", ",", "vL", ",", "overlap", ",", "normR", ",", "normL"}], 
       "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"vR", "=", 
        RowBox[{"vecsR", "[", 
         RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"vL", "=", 
        RowBox[{"vecsL", "[", 
         RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "Compute", " ", "the", " ", "overlap", " ", "and", " ", "normalize"}],
         "*)"}], "\[IndentingNewLine]", 
       RowBox[{"overlap", "=", 
        RowBox[{
         RowBox[{"ConjugateTranspose", "[", "vL", "]"}], ".", "vR"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"normR", "=", 
        RowBox[{"vR", "/", 
         RowBox[{"Sqrt", "[", "overlap", "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"normL", "=", 
        RowBox[{"vL", "/", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"Conjugate", "[", "overlap", "]"}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"Print", " ", "results"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Eigenvalue: \>\"", ",", 
         RowBox[{"valsR", "[", 
          RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<  Normalized Right vector: \>\"", ",", "normR"}], "]"}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<  Normalized Left vector:  \>\"", ",", "normL"}], "]"}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{
       "Print", "[", "\"\<-----------------------------------\>\"", "]"}], 
       ";"}]}], "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", 
      RowBox[{"Length", "[", "valsR", "]"}]}], "}"}]}], "\[IndentingNewLine]",
    "]"}], ";"}]}], "Input",
 CellChangeTimes->{{3.949440434722288*^9, 3.949440435716578*^9}, {
  3.949440476064726*^9, 3.949440593834963*^9}, {3.9494407841556473`*^9, 
  3.949440793791905*^9}},
 FontSize->18,
 CellLabel->
  "In[1080]:=",ExpressionUUID->"755c5594-8796-44e1-b37b-9ef6e92d2c4a"],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"Eigenvalue: \"\>", "\[InvisibleSpace]", 
   RowBox[{
    FractionBox["1", "2"], " ", 
    RowBox[{"(", 
     RowBox[{"z", "-", 
      SqrtBox[
       RowBox[{
        RowBox[{"4", " ", 
         SuperscriptBox["x", "2"]}], "+", 
        SuperscriptBox["z", "2"]}]]}], ")"}]}]}],
  SequenceForm[
  "Eigenvalue: ", 
   Rational[1, 2] ($CellContext`z - (4 $CellContext`x^2 + $CellContext`z^2)^
    Rational[1, 2])],
  Editable->False]], "Print",
 CellChangeTimes->{3.9494405783472633`*^9, 3.949440796579357*^9, 
  3.9494473747999897`*^9},
 CellLabel->
  "During evaluation of \
In[1080]:=",ExpressionUUID->"38e944e6-f85b-4874-a0ea-759f312c8f3e"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"  Normalized Right vector: \"\>", "\[InvisibleSpace]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       RowBox[{"z", "+", 
        SqrtBox[
         RowBox[{
          RowBox[{"4", " ", 
           SuperscriptBox["x", "2"]}], "+", 
          SuperscriptBox["z", "2"]}]]}], 
       RowBox[{"2", " ", "x", " ", 
        SqrtBox[
         RowBox[{"1", "+", 
          FractionBox[
           RowBox[{
            RowBox[{"(", 
             RowBox[{"z", "+", 
              SqrtBox[
               RowBox[{
                RowBox[{"4", " ", 
                 SuperscriptBox["x", "2"]}], "+", 
                SuperscriptBox["z", "2"]}]]}], ")"}], " ", 
            RowBox[{"(", 
             RowBox[{"z", "+", 
              RowBox[{"Conjugate", "[", 
               SqrtBox[
                RowBox[{
                 RowBox[{"4", " ", 
                  SuperscriptBox[
                   RowBox[{"Conjugate", "[", "x", "]"}], "2"]}], "+", 
                 SuperscriptBox[
                  RowBox[{"Conjugate", "[", "z", "]"}], "2"]}]], "]"}]}], 
             ")"}]}], 
           RowBox[{"4", " ", 
            SuperscriptBox["x", "2"]}]]}]]}]]}], ",", 
     FractionBox["1", 
      SqrtBox[
       RowBox[{"1", "+", 
        FractionBox[
         RowBox[{
          RowBox[{"(", 
           RowBox[{"z", "+", 
            SqrtBox[
             RowBox[{
              RowBox[{"4", " ", 
               SuperscriptBox["x", "2"]}], "+", 
              SuperscriptBox["z", "2"]}]]}], ")"}], " ", 
          RowBox[{"(", 
           RowBox[{"z", "+", 
            RowBox[{"Conjugate", "[", 
             SqrtBox[
              RowBox[{
               RowBox[{"4", " ", 
                SuperscriptBox[

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"plotEplusImag", "=", 
     RowBox[{"Plot3D", "[", 
      RowBox[{
       RowBox[{"Im", "[", 
        RowBox[{"Eplus", "[", 
         RowBox[{
          RowBox[{"d", "-", 
           RowBox[{"I", "*", 
            RowBox[{"gam", "/", "2"}]}]}], ",", "x"}], "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"d", ",", 
         RowBox[{
          RowBox[{"-", "3"}], " ", 
          RowBox[{"10", "^", "6"}], " ", "2", "Pi"}], ",", 
         RowBox[{"3", " ", 
          RowBox[{"10", "^", "6"}], " ", "2", "Pi"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0", ",", " ", 
         RowBox[{"10", "^", "7"}]}], "}"}], ",", 
       RowBox[{"PlotRange", "->", "All"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{"Gray", ",", 
          RowBox[{"Opacity", "[", "0.5", "]"}]}], "]"}]}], ",", 
       RowBox[{"(*", 
        RowBox[{"no", " ", "surface", " ", "shading"}], "*)"}], 
       RowBox[{"Mesh", "->", "Automatic"}], ",", 
       RowBox[{"(*", 
        RowBox[{"show", " ", "mesh", " ", "lines"}], "*)"}], 
       RowBox[{"MeshStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{"Gray", ",", "Thin"}], "]"}]}], ",", 
       RowBox[{"(*", 
        RowBox[{"gray", ",", 
         RowBox[{"thin", " ", "wireframe"}]}], "*)"}], 
       RowBox[{"Lighting", "->", "\"\<Neutral\>\""}], ",", 
       RowBox[{"(*", 
        RowBox[{"avoid", " ", "shading", " ", "effects"}], "*)"}], 
       RowBox[{"Axes", "->", "True"}], ",", 
       RowBox[{"AxesLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<\!\(\*TemplateBox[<|\"boxes\" -> FormBox[
SubscriptBox[\"\[CapitalDelta]\", \"2\"], TraditionalForm], \"errors\" -> {}, \
\"input\" -> \"\\\\Delta_2\", \"state\" -> \"Boxes\"|>,\"TeXAssistantTemplate\
\"]\)(rad/s)\>\"", 
          ",", "\"\<\!\(\*TemplateBox[<|\"boxes\" -> \
FormBox[\"\[CapitalOmega]\", TraditionalForm], \"errors\" -> {}, \"input\" -> \
\"\\\\Omega\", \"state\" -> \
\"Boxes\"|>,\"TeXAssistantTemplate\"]\)(rad/s)\>\"", 
          ",", "\"\<Im(E\!\(\*TemplateBox[<|\"boxes\" -> FormBox[\"\
\[PlusMinus]\", TraditionalForm], \"errors\" -> {}, \"input\" -> \"\\\\pm\", \
\"state\" -> \"Boxes\"|>,\"TeXAssistantTemplate\"]\))\>\""}], "}"}]}], ",", 
       RowBox[{"AxesStyle", "->", "Thick"}], ",", 
       RowBox[{"BoxRatios", "->", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1", ",", "1"}], "}"}]}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Second", " ", 
     RowBox[{"surface", ":", 
      RowBox[{"real", " ", "part", " ", "of", " ", "Eminus"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"plotEminusImag", "=", 
     RowBox[{"Plot3D", "[", 
      RowBox[{
       RowBox[{"Im", "[", 
        RowBox[{"Eminus", "[", 
         RowBox[{
          RowBox[{"d", "-", 
           RowBox[{"I", "*", 
            RowBox[{"gam", "/", "2"}]}]}], ",", "x"}], "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"d", ",", 
         RowBox[{
          RowBox[{"-", "3"}], " ", 
          RowBox[{"10", "^", "6"}], " ", "2", "Pi"}], ",", 
         RowBox[{"3", " ", 
          RowBox[{"10", "^", "6"}], " ", "2", "Pi"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0", ",", " ", 
         RowBox[{"10", "^", "7"}]}], "}"}], ",", 
       RowBox[{"PlotRange", "->", "All"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{"Gray", ",", 
          RowBox[{"Opacity", "[", "0.5", "]"}]}], "]"}]}], ",", 
       RowBox[{"Mesh", "->", "Automatic"}], ",", 
       RowBox[{"MeshStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{"Gray", ",", "Thin"}], "]"}]}], ",", 
       RowBox[{"Lighting", "->", "\"\<Neutral\>\""}], ",", 
       RowBox[{"Axes", "->", "True"}], ",", 
       RowBox[{"AxesLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<\!\(\*TemplateBox[<|\"boxes\" -> FormBox[
SubscriptBox[\"\[CapitalDelta]\", \"2\"], TraditionalForm], \"errors\" -> {}, \
\"input\" -> \"\\\\Delta_2\", \"state\" -> \"Boxes\"|>,\"TeXAssistantTemplate\
\"]\)(rad/s)\>\"", 
          ",", "\"\<\!\(\*TemplateBox[<|\"boxes\" -> \
FormBox[\"\[CapitalOmega]\", TraditionalForm], \"errors\" -> {}, \"input\" -> \
\"\\\\Omega\", \"state\" -> \
\"Boxes\"|>,\"TeXAssistantTemplate\"]\)(rad/s)\>\"", 
          ",", "\"\<Im(E\!\(\*TemplateBox[<|\"boxes\" -> FormBox[\"\
\[PlusMinus]\", TraditionalForm], \"errors\" -> {}, \"input\" -> \"\\\\pm\", \
\"state\" -> \"Boxes\"|>,\"TeXAssistantTemplate\"]\))\>\""}], "}"}]}], ",", 
       RowBox[{"AxesStyle", "->", "Thick"}], ",", 
       RowBox[{"BoxRatios", "->", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1", ",", "1"}], "}"}]}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Combine", " ", "both", " ", "surfaces", " ", "into", " ", "one", " ", 
     "3", "D", " ", "view"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Show", "[", 
    RowBox[{"plotEplusImag", ",", "plotEminusImag"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.949422982504079*^9, 3.9494229852888107`*^9}, 

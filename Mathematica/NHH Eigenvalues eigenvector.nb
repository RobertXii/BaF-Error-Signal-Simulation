Cell[CellGroupData[{

Cell["Calculate evolution operator of our time dependent nHH ", "Section",
 CellChangeTimes->{{3.950011863887126*^9, 
  3.950011892145308*^9}},ExpressionUUID->"29230038-17bc-4a30-96ed-\
dc1f854f8e0f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Clear", " ", "previous", " ", "definitions"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{
     "d12", ",", "E0", ",", "omega", ",", "d13", ",", "E_L2", ",", "E0nr", ",",
       "t0L2", ",", "t0nr", ",", "sigma", ",", "Delta1", ",", "Delta2", ",", 
      "gamma", ",", "t"}], "]"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Parameter", " ", "Definitions"}], "*)"}], "\[IndentingNewLine]", 
   
   RowBox[{
    RowBox[{"d12", "=", 
     RowBox[{
      RowBox[{"-", "33.6"}], "*", "2", "*", "Pi"}]}], ";"}], "         ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"dipole", " ", "moment", " ", "for", " ", "1"}], "-", 
     RowBox[{"2", " ", 
      RowBox[{"(", 
       RowBox[{"arbitrary", " ", "units"}], ")"}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"E0", "=", "40"}], ";"}], "                ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"field", " ", "amplitude", " ", "for", " ", "1"}], "-", 
     RowBox[{"2", " ", "transition"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"omega", "=", 
     RowBox[{"2", "*", "Pi", "*", "11.44", "*", 
      RowBox[{"10", "^", "3"}]}]}], ";"}], "    ", 
   RowBox[{"(*", 
    RowBox[{
    "angular", " ", "frequency", " ", "for", " ", "the", " ", "sine", " ", 
     "field"}], "*)"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"d13", "=", 
     RowBox[{
      RowBox[{"-", "2.15"}], "*", 
      RowBox[{"10", "^", "4"}], "*", "2", "*", "Pi"}]}], ";"}], "    ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"dipole", " ", "moment", " ", "for", " ", "1"}], "-", 
     RowBox[{"3", " ", "transition"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"EL2", "=", 
     RowBox[{"8.514", "*", 
      RowBox[{"10", "^", "2"}]}]}], ";"}], "         ", 
   RowBox[{"(*", 
    RowBox[{
    "electric", " ", "field", " ", "amplitude", " ", "for", " ", "L2"}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"E0nr", "=", "12"}], ";"}], "                 ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"additional", " ", "amplitude", " ", "for", " ", "non"}], "-", 
     RowBox[{"resonant", " ", "part"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"t0L2", "=", 
     RowBox[{"52.6", "*", 
      RowBox[{"10", "^", 
       RowBox[{"-", "6"}]}]}]}], ";"}], "         ", 
   RowBox[{"(*", 
    RowBox[{"center", " ", "of", " ", "the", " ", "Gaussian", " ", "pulse", " ", 
     RowBox[{"(", "s", ")"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"t0nr", "=", 
     RowBox[{"70.1", "*", 
      RowBox[{"10", "^", 
       RowBox[{"-", "6"}]}]}]}], ";"}], "         ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"center", " ", "of", " ", "the", " ", "non"}], "-", 
     RowBox[{"resonant", " ", "term", " ", 
      RowBox[{"(", "s", ")"}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"sigma", "=", 
     RowBox[{"0.52", "*", 
      RowBox[{"10", "^", 
       RowBox[{"-", "6"}]}]}]}], ";"}], "         ", 
   RowBox[{"(*", 
    RowBox[{"pulse", " ", "width", " ", 
     RowBox[{"(", "s", ")"}]}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Delta1", "=", 
     RowBox[{"2", "*", "Pi", "*", "2", "*", 
      RowBox[{"10", "^", "3"}]}]}], ";"}], "       ", 
   RowBox[{"(*", 
    RowBox[{"detuning", " ", "for", " ", "state", " ", "2", " ", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"2", " ", "transition"}]}], ")"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"Delta2", "=", 
     RowBox[{"2", "*", "Pi", "*", "1", "*", 
      RowBox[{"10", "^", "6"}], "*", "3"}]}], ";"}], "     ", 
   RowBox[{"(*", 
    RowBox[{"detuning", " ", "for", " ", "state", " ", "3", " ", 
     RowBox[{"(", 
      RowBox[{"L2", " ", "detuning"}], ")"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"gamma", "=", 
     RowBox[{"2.7", "*", 
      RowBox[{"10", "^", "6"}], "*", "2", "*", "Pi"}]}], ";"}], "      ", 
   RowBox[{"(*", 
    RowBox[{"decay", " ", "rate", " ", "for", " ", "state", " ", "3"}], 
    "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Define", " ", "the", " ", "time"}], "-", 
     RowBox[{"dependent", " ", "coupling", " ", "functions"}]}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"EStark", " ", "is", " ", "active", " ", "only", " ", "when"}], 
      "-", 
      RowBox[{"43.7", " ", "\[Micro]s"}]}], "<", "t", "<", 
     RowBox[{"43.7", " ", "\[Micro]s"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"EStark", "[", "t_", "]"}], ":=", 
     RowBox[{"Piecewise", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"d12", "*", "E0", "*", 
           RowBox[{"Sin", "[", 
            RowBox[{"omega", "*", 
             RowBox[{"(", 
              RowBox[{"t", "+", 
               RowBox[{"43.7", "*", 
                RowBox[{"10", "^", 
                 RowBox[{"-", "6"}]}]}]}], ")"}]}], "]"}]}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "43.7"}], "*", 
            RowBox[{"10", "^", 
             RowBox[{"-", "6"}]}]}], "<", "t", "<", 
           RowBox[{"43.7", "*", 
            RowBox[{"10", "^", 
             RowBox[{"-", "6"}]}]}]}]}], "}"}], "}"}], ",", "0"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Non", "-", 
     RowBox[{"resonant", " ", "coupling"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Enr", "[", "t_", "]"}], ":=", 
     RowBox[{"d12", "*", "E0nr", "*", 
      RowBox[{"Sech", "[", 
       RowBox[{"616", "*", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"t", "-", "t0nr"}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{"0.76", "*", 
           RowBox[{"10", "^", 
            RowBox[{"-", "2"}]}]}], ")"}]}]}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Combined", " ", "coupling", " ", "for", " ", "the", " ", "1"}], 
     "-", 
     RowBox[{"2", " ", "transition"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Omega", "[", "t_", "]"}], ":=", 
     RowBox[{
      RowBox[{"EStark", "[", "t", "]"}], "+", 
      RowBox[{"Enr", "[", "t", "]"}]}]}], ";"}], "\[IndentingNewLine]", "\n", 
   
   RowBox[{"(*", 
    RowBox[{"1", "-", 
     RowBox[{"3", " ", 
      RowBox[{"coupling", ":", 
       RowBox[{"Gaussian", " ", "pulse"}]}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Omega13prime", "[", "t_", "]"}], ":=", 
     RowBox[{"0.5", "*", "d13", "*", "EL2", "*", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"t", "-", "t0L2"}], ")"}], "^", "2"}], ")"}]}], "/", 
        RowBox[{"(", 
         RowBox[{"2", "*", 
          RowBox[{"sigma", "^", "2"}]}], ")"}]}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Define", " ", "the", " ", "3", "x3", " ", "non"}], "-", 
     RowBox[{"Hermitian", " ", "Hamiltonian", " ", "H", 
      RowBox[{"(", "t", ")"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"H", "[", "t_", "]"}], ":=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", 
         RowBox[{"Omega", "[", "t", "]"}], ",", 
         RowBox[{"Omega13prime", "[", "t", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Omega", "[", "t", "]"}], ",", "Delta1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Omega13prime", "[", "t", "]"}], ",", "0", ",", 
         RowBox[{"Delta2", "-", 
          RowBox[{"I", "*", 
           RowBox[{"(", 
            RowBox[{"gamma", "/", "2"}], ")"}]}]}]}], "}"}]}], "}"}]}], ";"}],
    "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Define", " ", "the", " ", "differential", " ", "equation", " ", "for", " ",
       "U", 
      RowBox[{"(", "t", ")"}], " ", "with", " ", "U", 
      RowBox[{"(", "0", ")"}]}], "=", 
     RowBox[{"IdentityMatrix", "[", "3", "]"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"eqn", "=", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"U", "[", "t", "]"}], ",", "t"}], "]"}], "==", 
      RowBox[{
       RowBox[{"-", "I"}], "*", 
       RowBox[{
        RowBox[{"H", "[", "t", "]"}], ".", 
        RowBox[{"U", "[", "t", "]"}]}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"initialCondition", "=", 
     RowBox[{
      RowBox[{"U", "[", 
       RowBox[{
        RowBox[{"-", "43.7"}], "*", 
        RowBox[{"10", "^", 
         RowBox[{"-", "6"}]}]}], "]"}], "==", 
      RowBox[{"IdentityMatrix", "[", "3", "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Solve", " ", "the", " ", "differential", " ", "equation", " ", 
      "numerically", " ", "from", " ", "t"}], "=", 
     RowBox[{
      RowBox[{"0", " ", "to", " ", "t"}], "=", "1"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sol", "=", 
     RowBox[{"NDSolve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"eqn", ",", "initialCondition"}], "}"}], ",", "U", ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", 
         RowBox[{
          RowBox[{"-", "43.7"}], "*", 
          RowBox[{"10", "^", 
           RowBox[{"-", "6"}]}]}], ",", 
         RowBox[{"150", "*", 
          RowBox[{"10", "^", 
           RowBox[{"-", "6"}]}]}]}], "}"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Extract", " ", "the", " ", "solution", " ", "at", " ", "t"}], "=",
      "1"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"U1td", "=", 
     RowBox[{
      RowBox[{"U", "[", 
       RowBox[{"55.3", "*", 
        RowBox[{"10", "^", 
         RowBox[{"-", "6"}]}]}], "]"}], "/.", " ", 
      RowBox[{"sol", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<The time-dependent evolution operator U(1,0) is:\>\"", 
     "]"}], ";"}], "\n", 
   RowBox[{"MatrixForm", "[", "U1td", "]"}]}]}]], "Input",
 CellChangeTimes->{{3.950011774383458*^9, 3.950011776920301*^9}, 

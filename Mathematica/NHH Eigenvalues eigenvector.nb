Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\n", 
  RowBox[{"(*", 
   RowBox[{"Define", " ", "the", " ", "time", " ", "variables"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"t0", "=", 
     RowBox[{
      RowBox[{"-", "43.7"}], "*", 
      RowBox[{"10", "^", 
       RowBox[{"-", "6"}]}]}]}], ";"}], "  ", 
   RowBox[{"(*", 
    RowBox[{"initial", " ", "time"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"tF", "=", "t"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"final", " ", "time", " ", "remains", " ", "symbolic"}], "*)"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Zeroth", "-", 
     RowBox[{"order", " ", 
      RowBox[{"term", ":", 
       RowBox[{"identity", " ", "matrix"}]}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"U0", "=", 
     RowBox[{"IdentityMatrix", "[", "3", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"First", "-", 
     RowBox[{"order", " ", "term"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"U1", "=", 
     RowBox[{
      RowBox[{"-", "I"}], " ", 
      RowBox[{"Integrate", "[", 
       RowBox[{
        RowBox[{"H", "[", "t1", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"t1", ",", "t0", ",", "tF"}], "}"}]}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Second", "-", 
     RowBox[{"order", " ", "term"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"U2", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"-", "I"}], ")"}], "^", "2"}], " ", 
      RowBox[{"Integrate", "[", 
       RowBox[{
        RowBox[{"Integrate", "[", 
         RowBox[{

Notebook[{

Cell[CellGroupData[{
Cell[TextData[StyleBox["Hermitian Hamiltonian Eigenvalues (2-level system)",
 FontWeight->"Bold"]], "Title",
 CellChangeTimes->{{3.949516895347188*^9, 
  3.949516934365649*^9}},ExpressionUUID->"ed6b2dbe-242b-4caf-8ed9-\
120876199333"],

Cell[CellGroupData[{

Cell[TextData[{
 "This part, I used the simple Hermitian matrix as demonstration and can be \
used as comparison for the NHH case which is demonstrated later. The \
eigenvalue is modelled as ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["E", "TI"], "\[PlusMinus]"], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{"-", "\[CapitalDelta]", "\[PlusMinus]", 
             SqrtBox[
              RowBox[{
                SuperscriptBox["\[CapitalOmega]", "2"], "+", 
                SuperscriptBox["\[CapitalDelta]", "2"]}]]}], ")"}], "/", 
         "2"}], TraditionalForm], "errors" -> {}, "input" -> 
     "E_{\\pm}=(-\\Delta\\pm\\sqrt{\\Omega^2+\\Delta^2})/2", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c7b43734-b83d-47cc-a863-4a0d8efa9582"],
 ". The mixing of the state is calculated using ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["P", "TI"], "\[PlusMinus]"], "\[LongEqual]", 
         FractionBox["1", "2"], 
         RowBox[{"(", 
           RowBox[{"1", "\[MinusPlus]", 
             FractionBox["\[CapitalDelta]", 
              SqrtBox[
               RowBox[{
                 SuperscriptBox["\[CapitalOmega]", "2"], "+", 
                 SuperscriptBox["\[CapitalDelta]", "2"]}]]]}], ")"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "P_{\\pm}=\\frac{1}{2}(1\\mp \
\\frac{\\Delta}{\\sqrt{\\Omega^2+\\Delta^2}})", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "529daec9-2541-4cd3-9092-6f292e402c5d"],
 "."
}], "Section",
 CellChangeTimes->{{3.949516959133422*^9, 3.949517046323625*^9}, {
   3.949517080186236*^9, 3.9495171230473423`*^9}, 
   3.949517230242052*^9},ExpressionUUID->"77ab3cb6-fe3c-4c06-8ded-\
c0bbf4f70193"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "This", " ", "is", " ", "when", " ", "the", " ", "hamiltonian", " ", "is", 
    " ", "hermitian"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Define", " ", "the", " ", "eigenvalue", " ", "functions", " ", "for", " ",
      "the", " ", "2", "\[Times]", "2", " ", "Hamiltonian"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Eplus", "[", 
      RowBox[{"delta_", ",", "omega_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "delta"}], "/", "2"}], "+", 
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{"omega", "^", "2"}], "+", 
          RowBox[{"delta", "^", "2"}]}], "]"}]}], ")"}], "/", "2"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Eminus", "[", 
      RowBox[{"delta_", ",", "omega_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "delta"}], "/", "2"}], "-", 
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{"omega", "^", "2"}], "+", 
          RowBox[{"delta", "^", "2"}]}], "]"}]}], ")"}], "/", "2"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"In", " ", "our", " ", "case"}], ",", 
     RowBox[{
      RowBox[{"we", " ", "set", " ", "gam"}], "=", 
      RowBox[{
       RowBox[{"0", " ", "so", " ", "that", " ", "z"}], "=", 
       RowBox[{"\[CapitalDelta]\:2082", " ", "is", " ", 
        RowBox[{"real", ".", "We"}], " ", "will", " ", "let", " ", "d", " ", 
        "denote", " ", "\[CapitalDelta]\:2082", " ", "and", " ", "x", " ", 
        "denote", " ", 
        RowBox[{"\[CapitalOmega]", "."}]}]}]}]}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{"Define", " ", "the", " ", "mixing", " ", 
     RowBox[{"(", 
      RowBox[{"ground", " ", "state", " ", "projection"}], ")"}], " ", "for", 
     " ", "each", " ", "eigenstate"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"mixingEplus", "[", 
      RowBox[{"delta_", ",", "omega_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"delta", "/", 
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{"delta", "^", "2"}], "+", 
           RowBox[{"omega", "^", "2"}]}], "]"}]}]}], ")"}], "/", "2"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"mixingEminus", "[", 
      RowBox[{"delta_", ",", "omega_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"delta", "/", 
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{"delta", "^", "2"}], "+", 
           RowBox[{"omega", "^", "2"}]}], "]"}]}]}], ")"}], "/", "2"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"Plot", " ", 
       RowBox[{"settings", ":", 
        RowBox[{
        "note", " ", "that", " ", "the", " ", "ranges", " ", "below", " ", 
         "are", " ", "as", " ", "given", " ", "in", " ", "your", " ", 
         "code"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"they", " ", "are", " ", "quite", " ", "large"}]}], ",", 
     RowBox[{"so", " ", "adjust", " ", "if", " ", 
      RowBox[{"necessary", "."}]}]}], "*)"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"plotEplus", "=", 
     RowBox[{"Plot3D", "[", 
      RowBox[{
       RowBox[{"Re", "[", 
        RowBox[{"Eplus", "[", 
         RowBox[{"delta", ",", "omega"}], "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"delta", ",", 
         RowBox[{
          RowBox[{"-", "3"}], "*", 
          RowBox[{"10", "^", "6"}], "*", "2", "*", "Pi"}], ",", 
         RowBox[{"3", "*", 
          RowBox[{"10", "^", "6"}], "*", "2", "*", "Pi"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"omega", ",", 
         RowBox[{
          RowBox[{"-", "2"}], "*", 
          RowBox[{"10", "^", "7"}]}], ",", 
         RowBox[{"2", "*", 
          RowBox[{"10", "^", "7"}]}]}], "}"}], ",", 
       RowBox[{"PlotRange", "->", "All"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{"Opacity", "[", "0.8", "]"}], "]"}]}], ",", 
       RowBox[{"ColorFunction", "->", 
        RowBox[{"Function", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"delta", ",", "omega", ",", "z"}], "}"}], ",", 
          RowBox[{
           RowBox[{"ColorData", "[", "\"\<Rainbow\>\"", "]"}], "[", 
           RowBox[{"mixingEplus", "[", 
            RowBox[{"delta", ",", "omega"}], "]"}], "]"}]}], "]"}]}], ",", 
       RowBox[{"ColorFunctionScaling", "->", "False"}], ",", 
       RowBox[{"Mesh", "->", "Automatic"}], ",", 
       RowBox[{"MeshStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{"Gray", ",", "Thin"}], "]"}]}], ",", 
       RowBox[{"Lighting", "->", "\"\<Neutral\>\""}], ",", 
       RowBox[{"Axes", "->", "True"}], ",", 
       RowBox[{"AxesLabel", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"Subscript", "[", 
            RowBox[{"\"\<\[CapitalDelta]\>\"", ",", "2"}], 
            "]"}], "\"\< (rad/s)\>\""}], 
          ",", "\"\<\[CapitalOmega] (rad/s)\>\"", 
          ",", "\"\<E\!\(\*TemplateBox[<|\"boxes\" -> \
FormBox[\"\[PlusMinus]\", TraditionalForm], \"errors\" -> {}, \"input\" -> \"\
\\\\pm\", \"state\" -> \"Boxes\"|>,\"TeXAssistantTemplate\"]\)\>\""}], 
         "}"}]}], ",", 
       RowBox[{"AxesStyle", "->", "Thick"}], ",", 
       RowBox[{"BoxRatios", "->", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1", ",", "1"}], "}"}]}], ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"BarLegend", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"ColorData", "[", "\"\<Rainbow\>\"", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "1"}], "}"}]}], "}"}], ",", 
          RowBox[{"LabelStyle", "->", 
           RowBox[{"{", 
            RowBox[{"Bold", ",", "12"}], "}"}]}], ",", 
          RowBox[{"LegendLabel", "->", "\"\<Exci. Prob.\>\""}]}], "]"}]}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"plotEminus", "=", 
     RowBox[{"Plot3D", "[", 
      RowBox[{
       RowBox[{"Re", "[", 
        RowBox[{"Eminus", "[", 
         RowBox[{"delta", ",", "omega"}], "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"delta", ",", 
         RowBox[{
          RowBox[{"-", "3"}], "*", 
          RowBox[{"10", "^", "6"}], "*", "2", "*", "Pi"}], ",", 
         RowBox[{"3", "*", 
          RowBox[{"10", "^", "6"}], "*", "2", "*", "Pi"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"omega", ",", 
         RowBox[{
          RowBox[{"-", "2"}], "*", 
          RowBox[{"10", "^", "7"}]}], ",", 
         RowBox[{"2", "*", 
          RowBox[{"10", "^", "7"}]}]}], "}"}], ",", 
       RowBox[{"PlotRange", "->", "All"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{"Opacity", "[", "0.8", "]"}], "]"}]}], ",", 
       RowBox[{"ColorFunction", "->", 
        RowBox[{"Function", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"delta", ",", "omega", ",", "z"}], "}"}], ",", 
          RowBox[{
           RowBox[{"ColorData", "[", "\"\<Rainbow\>\"", "]"}], "[", 
           RowBox[{"mixingEminus", "[", 
            RowBox[{"delta", ",", "omega"}], "]"}], "]"}]}], "]"}]}], ",", 
       RowBox[{"ColorFunctionScaling", "->", "False"}], ",", 
       RowBox[{"Mesh", "->", "Automatic"}], ",", 
       RowBox[{"MeshStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{"Gray", ",", "Thin"}], "]"}]}], ",", 
       RowBox[{"Lighting", "->", "\"\<Neutral\>\""}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Combine", " ", "the", " ", "two", " ", "surfaces", " ", "into", " ", 
     "one", " ", "3", "D", " ", "view"}], "*)"}], "\n", 
   RowBox[{"Show", "[", 
    RowBox[{"plotEplus", ",", "plotEminus"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.949421820064488*^9, 3.949421968986858*^9}, {
   3.949422016163899*^9, 3.9494221044486094`*^9}, {3.949422218417058*^9, 

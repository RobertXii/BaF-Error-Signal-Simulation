Cell[CellGroupData[{

Cell[TextData[StyleBox["Non-Hermitian Hamiltonian Eigenvalues/Eigenvectors \
(2-level system)",
 FontWeight->"Bold"]], "Title",
 CellChangeTimes->{{3.949440625459848*^9, 
  3.949440631876718*^9}},ExpressionUUID->"44f3891f-52a3-4bea-b648-\
5d5500eb35e5"],

Cell[CellGroupData[{

Cell["Eigenvalues (Real part and Imaginary part)", "Section",
 CellChangeTimes->{
  3.9494406471488447`*^9},ExpressionUUID->"df8c303a-d012-4f10-b889-\
d0ea8e679efe"],

Cell[TextData[{
 "NHH gives some unexpected eigenvalues. First of all, the eigenvalues are \
complex, and there\[CloseCurlyQuote]s a special line where the real parts of \
the eigenvalues coalesce, indicating an exceptional point. The code \
calculates these eigenvalues, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["E", "TI"], "+"], TraditionalForm], "errors" -> {}, "input" -> 
     "E_+", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d0b7a9bf-03a2-493a-aff8-8fb8722aa7df"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["E", "TI"], "-"], TraditionalForm], "errors" -> {}, "input" -> 
     "E_-", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d5bdb882-0a4d-4b88-96fa-f6ad4ac9f421"],
 ", for a non-Hermitian Hamiltonian and visualizes the real and imaginary \
parts of both surfaces using 3D plots. The plots reveal how the eigenvalues \
depend on system parameters, showing the characteristic branching structure \
typical of non-Hermitian systems. Here, I put some real experiment values for \
the two level system under a laser (L2) depletion. [gam = decay rate; d = L2 \
detuning; x = Rabi frequency = ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["d", "TI"], "12"], "\[CenterDot]", 
         SubscriptBox[
          StyleBox["E", "TI"], 
          RowBox[{
            StyleBox["L", "TI"], "2"}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "d_{12} \\cdot E_{L2}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c46cb761-0b90-4fc6-a272-c0238b1964c1"],
 "]"
}], "Subsection",
 CellChangeTimes->{
  3.949440670871624*^9},ExpressionUUID->"fc00b0fd-9241-415d-80ef-\
c1a701210ab2"],

Cell[CellGroupData[{

Cell["", "Subsection",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.949439543888727*^9, 3.949439559970229*^9}, {
  3.9494397204490757`*^9, 3.949439721107914*^9}, {3.9494397884869547`*^9, 
  3.9494398753917103`*^9}, {3.9494400133516483`*^9, 3.949440260081915*^9}, {
  3.9494406575769787`*^9, 3.949440660046329*^9}},
 FontSize->18,ExpressionUUID->"a9f52002-11ed-45b6-9e84-c211a76ba2f8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "This", " ", "is", " ", "when", " ", "the", " ", "hamiltonian", " ", "is",
      " ", "non"}], "-", "hermitian"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
   
   RowBox[{
    RowBox[{
     RowBox[{"Eplus", "[", 
      RowBox[{"z_", ",", "x_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"z", "+", 
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{"4", 
           RowBox[{"x", "^", "2"}]}], "+", 
          RowBox[{"z", "^", "2"}]}], "]"}]}], ")"}], "/", "2"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Eminus", "[", 
      RowBox[{"z_", ",", "x_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"z", "-", 
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{"4", 
           RowBox[{"x", "^", "2"}]}], "+", 
          RowBox[{"z", "^", "2"}]}], "]"}]}], ")"}], "/", "2"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gam", "=", 
     RowBox[{"2.7", " ", 
      RowBox[{"10", "^", "6"}], " ", "2", "Pi"}]}], ";"}], " ", 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"First", " ", 
     RowBox[{"surface", ":", 
      RowBox[{"real", " ", "part", " ", "of", " ", "Eplus"}]}]}], "*)"}], 
   RowBox[{
    RowBox[{"plotEplus", "=", 
     RowBox[{"Plot3D", "[", 
      RowBox[{
       RowBox[{"Re", "[", 
        RowBox[{"Eplus", "[", 
         RowBox[{
          RowBox[{"d", "-", 
           RowBox[{"I", "*", 
            RowBox[{"gam", "/", "2"}]}]}], ",", "x"}], "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"d", ",", 
         RowBox[{
          RowBox[{"-", "3"}], " ", 
          RowBox[{"10", "^", "6"}], " ", "2", "Pi"}], ",", 
         RowBox[{"3", " ", 
          RowBox[{"10", "^", "6"}], " ", "2", "Pi"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"-", 
          RowBox[{"10", "^", "7"}]}], ",", " ", 
         RowBox[{"10", "^", "7"}]}], "}"}], ",", 
       RowBox[{"PlotRange", "->", "All"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{"Gray", ",", 
          RowBox[{"Opacity", "[", "0.5", "]"}]}], "]"}]}], ",", 
       RowBox[{"(*", 
        RowBox[{"no", " ", "surface", " ", "shading"}], "*)"}], 
       RowBox[{"Mesh", "->", "Automatic"}], ",", 
       RowBox[{"(*", 
        RowBox[{"show", " ", "mesh", " ", "lines"}], "*)"}], 
       RowBox[{"MeshStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{"Gray", ",", "Thin"}], "]"}]}], ",", 
       RowBox[{"(*", 
        RowBox[{"gray", ",", 
         RowBox[{"thin", " ", "wireframe"}]}], "*)"}], 
       RowBox[{"Lighting", "->", "\"\<Neutral\>\""}], ",", 
       RowBox[{"(*", 
        RowBox[{"avoid", " ", "shading", " ", "effects"}], "*)"}], 
       RowBox[{"Axes", "->", "True"}], ",", 
       RowBox[{"AxesLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<\!\(\*TemplateBox[<|\"boxes\" -> FormBox[
SubscriptBox[\"\[CapitalDelta]\", \"2\"], TraditionalForm], \"errors\" -> {}, \
\"input\" -> \"\\\\Delta_2\", \"state\" -> \"Boxes\"|>,\"TeXAssistantTemplate\
\"]\)(rad/s)\>\"", 
          ",", "\"\<\!\(\*TemplateBox[<|\"boxes\" -> \
FormBox[\"\[CapitalOmega]\", TraditionalForm], \"errors\" -> {}, \"input\" -> \
\"\\\\Omega\", \"state\" -> \
\"Boxes\"|>,\"TeXAssistantTemplate\"]\)(rad/s)\>\"", 
          ",", "\"\<Re(E\!\(\*TemplateBox[<|\"boxes\" -> FormBox[\"\
\[PlusMinus]\", TraditionalForm], \"errors\" -> {}, \"input\" -> \"\\\\pm\", \
\"state\" -> \"Boxes\"|>,\"TeXAssistantTemplate\"]\))\>\""}], "}"}]}], ",", 
       RowBox[{"AxesStyle", "->", "Thick"}], ",", 
       RowBox[{"BoxRatios", "->", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1", ",", "1"}], "}"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Second", " ", 
     RowBox[{"surface", ":", 
      RowBox[{"real", " ", "part", " ", "of", " ", "Eminus"}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"plotEminus", "=", 
     RowBox[{"Plot3D", "[", 
      RowBox[{
       RowBox[{"Re", "[", 
        RowBox[{"Eminus", "[", 
         RowBox[{
          RowBox[{"d", "-", 
           RowBox[{"I", "*", 
            RowBox[{"gam", "/", "2"}]}]}], ",", "x"}], "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"d", ",", 
         RowBox[{
          RowBox[{"-", "3"}], " ", 
          RowBox[{"10", "^", "6"}], " ", "2", "Pi"}], ",", 
         RowBox[{"3", " ", 
          RowBox[{"10", "^", "6"}], " ", "2", "Pi"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"-", 
          RowBox[{"10", "^", "7"}]}], ",", " ", 
         RowBox[{"10", "^", "7"}]}], "}"}], ",", 
       RowBox[{"PlotRange", "->", "All"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{"Gray", ",", 
